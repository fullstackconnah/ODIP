VITE_API_BASE_URL=http://localhost:5062/api/v1

# Firebase (values from Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dev auth (local/internal use only) — set to 'true' to enable a password-less
# developer login that bypasses Firebase. Also requires DEV_AUTH_ENABLED=true
# on the API for the /auth/dev-login and /auth/dev-users endpoints to respond.
# VITE_DEV_AUTH=true
