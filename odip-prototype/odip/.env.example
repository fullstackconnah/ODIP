# Odip — Portainer Stack Environment Variables
# Copy these into Portainer stack env settings (do NOT commit actual values)

# Required — no defaults, stack will not start without these
POSTGRES_PASSWORD=<strong-password-16-chars-min>
JWT_SECRET=<random-32-char-string>
ALLOWED_ORIGINS=http://<your-server-address>:8475

# Optional — defaults shown
ASPNETCORE_ENVIRONMENT=Production

# Roster top-up (plan builder): the daily job that keeps open shifts generated for the patterns an approved service agreement made.
# Hand-made and demo patterns are never touched. HORIZON_DAYS (7 to 366) is how many days ahead of the provider's today shifts are
# kept, and how many an approval generates at once.
ROSTER_TOP_UP_ENABLED=true
ROSTER_TOP_UP_HORIZON_DAYS=56